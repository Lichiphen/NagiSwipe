# Cloudflare Pages cache headers
# Pages and anything without ?v=: always revalidate.
# NagiSwipe-main.js / .css stay revalidated too: other sites may load them without ?v=.
/*
  Cache-Control: no-cache

# The site's own files and images are referenced with ?v=<content hash> (site/build.py)
/site/site.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/site/site.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/site/search.json
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/site/search.en.json
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/site/favicon.svg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/img/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/manga/docs/images/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
