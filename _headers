# Cloudflare Pages cache headers
# HTML / CSS / JS: always revalidate. index.html reads Last-Modified of the CSS/JS
# with a HEAD request to build ?v=, so they must not be cached as immutable.
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
/*.js
  Cache-Control: no-cache

# Demo images are referenced with ?v=<content hash>
/img/*
  Cache-Control: public, max-age=31536000, immutable
