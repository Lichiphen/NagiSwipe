# NagiManga admin
Options -Indexes

# --- Optional: allow the admin only from your IP address -------------------
# Remove the "#" at the start of the lines below and put your IP address.
# (The admin also checks its own IP list in the settings, so this is a second lock.)
#
# <IfModule mod_authz_core.c>
#     Require ip 203.0.113.10
# </IfModule>
# <IfModule !mod_authz_core.c>
#     Order deny,allow
#     Deny from all
#     Allow from 203.0.113.10
# </IfModule>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
