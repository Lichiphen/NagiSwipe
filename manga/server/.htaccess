# NagiManga: basic protection (Apache)
Options -Indexes
DirectoryIndex index.php

# LiteSpeed only: serve the public LOG pages PHP marked as cacheable (X-LiteSpeed-Cache-Control).
# Other servers skip this block. The admin, the owner's pages and images are never cached.
<IfModule LiteSpeed>
    CacheLookup on
</IfModule>

# Use the animated 404 page for missing paths, at any installation depth.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Scripts, styles and pictures requested with ?v=<content hash> never change under that URL.
    RewriteCond %{QUERY_STRING} (^|&)v=[0-9a-f.]+(&|$)
    RewriteRule \.(js|css|svg|png)$ - [E=NM_VERSIONED:1]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

# Hidden files, backups and docs are never served
<FilesMatch "(^\.|\.(md|log|lock|bak|tmp|json|ini|sh|zip)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # Pages, the viewer and the admin assets: always revalidate (cheap 304s), unless
    # requested with ?v=<content hash> (below). Page images come from read.php / the LOG
    # with their own cache headers.
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # The bundled LOG share image is always requested with ?v=<content hash>.
    <FilesMatch "^log-og\.png$">
        Header set Cache-Control "max-age=31536000, immutable"
    </FilesMatch>
    # Any script, style or picture loaded with ?v=<content hash> (see the rewrite rule above): keep it for a year.
    # A changed file gets a new hash, so browsers skip the revalidation request on every page.
    <FilesMatch "\.(js|css|svg|png)$">
        Header set Cache-Control "max-age=31536000, immutable" env=NM_VERSIONED
    </FilesMatch>
</IfModule>
