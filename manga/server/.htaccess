# NagiManga: basic protection (Apache)
Options -Indexes
DirectoryIndex index.php

# LiteSpeed only: serve the public LOG pages PHP marked as cacheable (X-LiteSpeed-Cache-Control).
# Other servers skip this block. The admin, the owner's pages and images are never cached.
<IfModule LiteSpeed>
    CacheLookup on
</IfModule>

# Use the animated 404 page for missing paths, at any installation depth.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

# Hidden files, backups and docs are never served
<FilesMatch "(^\.|\.(md|log|lock|bak|tmp|json|ini|sh|zip)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # Pages, the viewer and the admin assets: always revalidate (cheap 304s).
    # Share tags load the viewer with ?v=<content hash>; page images come from
    # read.php with their own cache headers.
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # The bundled LOG share image is always requested with ?v=<content hash>.
    <FilesMatch "^log-og\.png$">
        Header set Cache-Control "max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
